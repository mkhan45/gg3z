Begin Facts:
    StateVar RunnerY
    StateVar RunnerVY
    StateVar ObstacleX
    StateVar ObstacleVX
    StateVar Dead
    RunnerY = 0.0
    RunnerVY = 0.0
    ObstacleX = 800.0
    ObstacleVX = 12.0
    Dead = no
End Facts

Begin Global:
    Rule ShouldJump:
    real_eq(RunnerY, 0.0) & key_pressed(space)
    ------------------------------------------
    shouldJump()

    Rule RespawnObstacle:
    ObstacleX .< -24.0
    -----------------------
    shouldRespawnObstacle()

    Rule GameOver:
    RunnerY .< 8.0 & ObstacleX .< 16.0
    ---------------------------------
    collided()
End Global

Begin Stage Control:
    Begin State Constraints:
        when shouldJump(): next(RunnerVY) = 28.0
        otherwise: preserve(RunnerVY)

        when shouldRespawnObstacle():
            next(ObstacleX) = 800.0 & 
            real_add(ObstacleVX, 2.0, next(ObstacleVX))
        otherwise:
            real_sub(ObstacleX, ObstacleVX, next(ObstacleX)) &
            preserve(ObstacleVX)

        when collided(): next(Dead) = yes
        otherwise: preserve(Dead)
    End State Constraints
End Stage Control

Begin Stage Physics:
    Begin State Constraints:
        real_sub(RunnerVY, 4.0, NewVY)
        real_add(RunnerY, RunnerVY, NewY)

        when NewY .> 0.0:
            real_sub(RunnerVY, 4.0, next(RunnerVY)) &
            real_add(RunnerY, RunnerVY, next(RunnerY))
        otherwise:
            next(RunnerY) = 0.0 &
            next(RunnerVY) = 0.0
    End State Constraints
End Stage Physics

Begin Stage Draw:
    With
        Dead = no
    Draw
        rect(8.0, RunnerY, 8.0, 8.0)
        rect(ObstacleX, 0.0, 8.0, 8.0)

    With
        Dead = yes
    Draw
        rect(320.0, 320.0, 8.0, 8.0)
        rect(480.0, 320.0, 8.0, 8.0)
        rect(368.0, 200.0, 72.0, 8.0)
        rect(360.0, 184.0, 8.0, 16.0)
        rect(440.0, 184.0, 8.0, 16.0)
End Stage Draw
